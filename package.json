{
  "name": "civicfolio",
  "private": true,
  "version": "0.1.0",
  "description": "Personal localhost investment research app: disclosure feed, source-cited research chat, paper portfolio.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "test": "node --import tsx --test server/test/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "^4.22.2",
    "openai": "^7.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.1.0"
  }
}
