# Civicfolio server configuration (server-side only; never exposed to the frontend)
# Copy to .env for local use. OPENAI_API_KEY is required only for AI features.

# Port for the local API server (default 8787). Server always binds 127.0.0.1.
CIVICFOLIO_PORT=8787

# Where JSON data is stored. Default: ~/.civicfolio (outside this repo, untracked).
# CIVICFOLIO_DATA_DIR=/Users/you/.civicfolio

# --- OpenAI (AI research + LLM chat) ---------------------------------------
# Server-only env variables. The frontend cannot set or see these, and the key
# is never included in any API response or error message.
#
# REQUIRED for AI research and LLM chat. Without it both fail immediately with
# an explicit error and no network call; the deterministic engine still works
# fully offline with zero API keys.
OPENAI_API_KEY=
#
# Optional. Default: gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# How direct the research chat is allowed to be. Server-side only.
#   advisor (default) - direct, evidence-backed research view
#   analyst           - lays out considerations, no directive buy/sell calls
# Advisor mode still refuses to invent precision the data cannot support:
# no price targets or probability scores off week-old range data.
# CIVICFOLIO_ADVISOR_MODE=advisor

# NOTE: Robinhood / brokerage execution is intentionally NOT configured and
# remains disabled. No brokerage credentials are read or stored.
# --- EXPERIMENTAL: Deep Research (off by default) ---------------------------
# TradingAgents-inspired researcher + reviewer over a verified evidence packet.
# Read-only research: it places no orders and cannot touch the paper fund.
# Unset, or anything other than 1/true/on, keeps it disabled and the route 404s.
# See docs/DEEP_RESEARCH_EXPERIMENT.md.
# CIVICFOLIO_DEEP_RESEARCH=1
#
# Optional. Token usage is always reported; a dollar figure is shown ONLY when
# both rates are set from the current published price list. Left unset, cost is
# reported as unknown rather than guessed from a possibly stale rate.
# CIVICFOLIO_USD_PER_MTOK_IN=0.15
# CIVICFOLIO_USD_PER_MTOK_OUT=0.60
